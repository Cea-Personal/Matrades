MATRADES_ENV=development
MATRADES_DATABASE_URL=postgresql+asyncpg://matrades:matrades@localhost:5432/matrades
MATRADES_REDIS_URL=redis://localhost:6379/0
MATRADES_SECRET_KEY=replace-with-at-least-32-characters
MATRADES_MT5_BRIDGE_SECRET=replace-with-a-long-random-mt5-bridge-secret
MATRADES_BLOB_ROOT=data/blobs
MATRADES_RESEARCH_ARTIFACT_ROOT=data/research_cycles
MATRADES_CODEX_ENABLED=true
MATRADES_LITELLM_ENABLED=false
MATRADES_LITELLM_URL=http://localhost:4000
MATRADES_DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000001
MATRADES_TWELVE_DATA_API_KEY=
MATRADES_RESEARCH_FOREX_UNIVERSE=EUR/USD,GBP/USD,USD/JPY,AUD/USD,USD/CAD
MATRADES_RESEARCH_METALS_UNIVERSE=XAU/USD,XAG/USD
MATRADES_RESEARCH_CRYPTO_UNIVERSE=BTC-USD,ETH-USD,SOL-USD
MATRADES_RESEARCH_CANDLE_COUNT=100
MATRADES_RESEARCH_SCHEDULE_ENABLED=true
MATRADES_RESEARCH_SCHEDULE_HOUR_UTC=5
MATRADES_RESEARCH_SCHEDULE_MINUTE_UTC=0
MATRADES_RESEARCH_AGENT_TIMEOUT_SECONDS=90
MATRADES_STRATEGY_RESEARCH_MAX_MARKET_AGE_HOURS=24
MATRADES_STRATEGY_RESEARCH_HISTORY_DAYS=45
MATRADES_STRATEGY_RESEARCH_TIMEFRAME=4h
MATRADES_STRATEGY_RESEARCH_DISCOVERY_RATIO=0.70
