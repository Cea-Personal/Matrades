# The development proxy is intentionally addressed through localhost. Naming the
# host lets Caddy issue its internal development certificate for the TLS handshake.
localhost:443 {
  tls internal
  encode zstd gzip
  header {
    # The web application generates a per-request nonce CSP so its hydration
    # scripts can run without allowing arbitrary inline scripts.
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
  }
  handle /api/v1/* {
    reverse_proxy api:8000
  }
  handle /events {
    reverse_proxy api:8000
  }
  handle {
    reverse_proxy web:3000
  }
}
